@page
@model Calculated_Fields.Pages.CalculateModel
@{
    ViewData["Title"] = "Calculate";
}
<div class="container">
    <main>
        <form method="post">
            <label for="name">Name :</label>
            <input name="name" type="text"/>
            <label for="value">Value :</label>
            <label for="value" class="toolTipLabel"></label>
            <input name="value" type="text" ondragover="allowDrop(event)" ondrop="dropValue(event)" class="completable" list="createSuggest"/>
            <label for="type">Is Calculated :</label>
            <input name="type" type="checkbox"/>
            <button type="submit" asp-page-handler="AddField">Add Field</button>
        </form>
        <form asp-page-handler="Calculate" method="post">
            <div id="fields" class="list-group">
            @for(int i = 0 ; i < Model.AllFields.Count; i++){
                    <div class="Field list-group-item">
                    <span draggable="true" data-name="@Model.AllFields[i].name" ondragstart="dragStart(event,'data')">⩨</span>
                    <button onclick="pickValue('@Model.AllFields[i].name','data',event)">▨</button>
                    <label for="AllFields[@i].name" id="fieldLabel_@Model.AllFields[i].Id">@Model.AllFields[i].name :</label>
                    @{if(Model.AllFields[i].type.Equals(Calculated_Fields.Models.Type.CALCULATED)){
                        <input type="text" data-target="fieldValue_@Model.AllFields[i].Id" ondragover="allowDrop(event)" ondrop="dropValue(event)" class="completable calculated" value=@(Model.Results.GetValueOrDefault(Model.AllFields[i].Id)) />
                        <input type="hidden" id="fieldValue_@Model.AllFields[i].Id" name="fieldValue_@Model.AllFields[i].Id" value="@(Model.AllFields[i].value)" />
                    }
                    else{
                        <input name="fieldValue_@Model.AllFields[i].Id" ondragover="allowDrop(event)" ondrop="dropValue(event)" class="completable" value="@(Model.AllFields[i].value)" />
                    }
                    }
                    <input name="fieldValue_@Model.AllFields[i].Id" type="hidden"/>
                    <input name="fieldName_@Model.AllFields[i].Id" id="NameRename@(Model.AllFields[i].Id)" style="display:none" value="@Model.AllFields[i].name" />
                    <button type="button" onclick="Rename(@(Model.AllFields[i].Id))">rename</button>
                    <button type="submit" asp-page-handler="RemoveField" asp-route-id=@Model.AllFields[i].Id>remove</button>
                <br/>
                </div>
            }
            </div>
            <button type="submit">Save</button>
        </form>
    </main>

    <aside>
        <h3>Cheat Sheet</h3>
        <h5>Prefix Operators</h5>
        <ul>
            <li> ! : Logical NOT </li>
            <li> not : Logical NOT </li>
            <li> - : Negation </li>
            <li> ~ : Bitwise NOT </li>
        </ul>

        <h5>Suffix operators : ! : Factorial</h5>
        
        <h5>Prefix Operators</h5>
        <ul>
            <li> + : Addition </li>
            <li> - : Subtraction </li>
            <li> * : Multiplication </li>
            <li> / : Division </li>
            <li> % : Modulus </li>
            <li> ** : Exponentiation </li>
        </ul>
        @foreach(var function in Model.Functions) {
            <div class="function" data-tippy-content="@function.tooltip">
                <span draggable="true" data-name="@function.equation" ondragstart="dragStart(event,'function',' @function.tooltip')">≡</span>
                @function.name
                <button onclick="pickValue('@function.equation','function',event)">⩨</button>
            </div>
        }
    </aside>
</div>
<script src="https://unpkg.com/@@popperjs/core@2/dist/umd/popper.min.js"></script>
<script src="~/lib/tippy/tippy-bundle.umd.min.js"></script>
<script src="~/lib/tribute/tribute.min.js"></script>
<script>
    const allFields = @Html.Raw(
        System.Text.Json.JsonSerializer.Serialize(Model.AllFields)
    );
    const functions = @Html.Raw(
        System.Text.Json.JsonSerializer.Serialize(Model.Functions)
    );

    tippy('[data-tippy-content]',{
        placement: 'right',
        arrow: false,
    });

    tippy(document.querySelectorAll('.completable'),{
        placement: 'top',
        arrow: false,
        trigger: 'focus'
    });
    
    let previousinput = null;
    let currentinput = null;
    let lastStartSelect;
    let lastEndSelect;

    function selectionUpdate(input){
        lastStartSelect = input.selectionStart;
        lastEndSelect = input.selectionEnd;
    }
    
    
    function updateTooltip(){
        if(!currentinput){
            //currentinput._tippy.hide();
            return;
        } 
        const cursorPos = currentinput.selectionStart;
        const value = currentinput.value;

        const textBeforeCursor = value.substring(0, cursorPos);

        // Match the last token (sequence of letters, numbers, or _)
        const tokenMatch = textBeforeCursor.match(/([a-zA-Z_][a-zA-Z0-9_]*)\($/);
        const textUpToCursor = tokenMatch ? tokenMatch[0] : "";

        // Find the function
        const func = functions.find(x => x.name.toLowerCase()+"(" === textUpToCursor.toLowerCase());
        if(func){
            currentinput._tippy.setContent(func.tooltip);
            currentinput._tippy.show();
        }else{
            currentinput._tippy.hide();
        }
    }

    const ExpressionTributeValues = [];
    const AllTributeValues = [];
        
    for (let i = 0; i < allFields.length; i++) {
        ExpressionTributeValues.push({
            key: allFields[i].name,
            value: "["+allFields[i].name+"]",
            tooltip:''
        });
        AllTributeValues.push({
            key: allFields[i].name,
            value: "["+allFields[i].name+"]",
            tooltip:''
        });
    }
    for (let i = 0; i < functions.length; i++) {
        AllTributeValues.push({
            key: functions[i].name,
            value: functions[i].equation,
            tooltip: functions[i].tooltip
        });
    }

    const tribute = new Tribute({
        selectOnEnter : false,
        collection: [
            {
                trigger: " ",
                values: AllTributeValues,
                selectTemplate: function (item) {
                    const element = tribute.current.element;
                    if(item.original.tooltip.length > 0){
                        setTimeout( () => {
                            const cursorPos = element.selectionStart;
                            if(item.original.value.includes(',')){
                                element.setSelectionRange(cursorPos-3,cursorPos-3);
                            }
                            else{
                                element.setSelectionRange(cursorPos-2,cursorPos-2);
                            }
                            updateTooltip();
                        },0);
                    }
                    return item.original.value;
                },
                selectClass: '.completable',
                menuItemTemplate: function (item) {
                    if(item.original.tooltip.length > 0){
                        return '<div title="'+item.original.tooltip+'">'+item.string+'</div>';}
                    else{
                        return item.string;
                    }
                }
            },
            {
                trigger: "(",
                values: AllTributeValues,
                selectTemplate: function (item) {
                    const element = tribute.current.element;
                    if(item.original.tooltip.length > 0){
                        setTimeout( () => {
                            const cursorPos = element.selectionStart;
                            if(item.original.value.includes(',')){
                                element.setSelectionRange(cursorPos-3,cursorPos-3);
                            }
                            else{
                                element.setSelectionRange(cursorPos-2,cursorPos-2);
                            }
                            updateTooltip();
                        },0);
                    }
                    return "("+item.original.value;
                },
                selectClass: '.completable',
                menuItemTemplate: function (item) {
                    if(item.original.tooltip.length > 0){
                        return '<div title="'+item.original.tooltip+'">'+item.string+'</div>';}
                    else{
                        return item.string;
                    }
                }
            },
            {
                trigger: ",",
                values: AllTributeValues,
                selectTemplate: function (item) {
                    const element = tribute.current.element;
                    if(item.original.tooltip.length > 0){
                        setTimeout( () => {
                            const cursorPos = element.selectionStart;
                            if(item.original.value.includes(',')){
                                element.setSelectionRange(cursorPos-3,cursorPos-3);
                            }
                            else{
                                element.setSelectionRange(cursorPos-2,cursorPos-2);
                            }
                            updateTooltip();
                        },0);
                    }
                    return ","+item.original.value;
                },
                selectClass: '.completable',
                menuItemTemplate: function (item) {
                    if(item.original.tooltip.length > 0){
                        return '<div title="'+item.original.tooltip+'">'+item.string+'</div>';}
                    else{
                        return item.string;
                    }
                }
            },
            {
                trigger: '[',
                values: ExpressionTributeValues,
                selectTemplate: function (item) {
                    return item.original.value;
                }
            }
        ],
        noMatchTemplate: function () { return ''; },
        allowSpaces: true
    });

    document.querySelectorAll('.calculated').forEach(input => {
        input.addEventListener('focus', (e) => {
            const hidden = document.getElementById(input.dataset.target);
            input.value = hidden.value;
            updateTooltip();
        });
        input.addEventListener('blur', (e) => {
            const hidden = document.getElementById(input.dataset.target);
            hidden.value = input.value;
            const fieldId = input.dataset.target.replace('fieldValue_', '');
            const fieldName = document.getElementById("NameRename"+fieldId).value;
            document.getElementById("fieldLabel_"+fieldId).innerText = fieldName + " :";
            const fieldValue = hidden.value;
            const path = "?handler=Update&Id="+encodeURIComponent(fieldId)+"&name="+encodeURIComponent(fieldName)+"&value="+encodeURIComponent(fieldValue);
            fetch(path)
                .then(res => res.json())
                .then(result => {
                    for(var k in result.data){
                        var now = document.querySelector('[data-target="fieldValue_'+k+'"]')
                        if(now !== currentinput || currentinput === previousinput){
                            now.value = result.data[k].result;
                        }
                    }
                });
            previousinput = currentinput;
            currentinput = input;
        });
    });
    document.querySelectorAll("form").forEach(form => {
        form.addEventListener("submit", e => {
            if (e.submitter === null) e.preventDefault();
        });
    });
    document.querySelectorAll('.completable').forEach(input => {
        tribute.attach(input);
        input.addEventListener("keydown", (e) => {
            if (e.key === "Enter") {
                e.preventDefault();
            }
        });
        input.addEventListener("focus", (e) => {
            previousinput = currentinput;
            currentinput = e.target;
            selectionUpdate(e.target);
            updateTooltip();
        });
        input.addEventListener("input", (e) => {
            selectionUpdate(e.target);
            previousinput = currentinput;
            updateTooltip();
        });
        input.addEventListener("keyup", (e) => {
            selectionUpdate(e.target);
            updateTooltip();
        });
        input.addEventListener("click", (e) => {
            selectionUpdate(e.target);
            updateTooltip();
        });
    });

    function pickValue(text,type,event) {
        event.preventDefault();
        const input = currentinput;
        const start = lastStartSelect;
        const end = lastEndSelect;
        input.focus();
        if(type === 'function'){
            input.value = input.value.substring(0, start) + " " + text + " " + input.value.substring(end);
        }else{
            input.value = input.value.substring(0, start) + " [" + text + "] " + input.value.substring(end);
        }
        if (type === 'function'){
            if (text.includes(',')){
                input.selectionStart = input.selectionEnd = start + text.length - 1;
            }else{
                input.selectionStart = input.selectionEnd = start + text.length;
            }
        }else{
            input.selectionStart = input.selectionEnd = start + text.length + 5;
        }
        selectionUpdate(input);
        input.focus();
    }

    function dragStart(event,type,tooltip) {
        event.dataTransfer.setData("name", event.currentTarget.dataset.name);
        event.dataTransfer.setData("type", type);
        event.dataTransfer.setData("tooltip", tooltip);

        const dragIcon = document.createElement("div");
        dragIcon.style.width = "fit-content";
        dragIcon.style.height = "30px";
        
        dragIcon.style.color = "white";
        dragIcon.style.borderRadius = "5px";
        dragIcon.style.fontWeight = "bold";
        
        
        if(type == 'function'){
            dragIcon.style.backgroundColor = "blue";
            dragIcon.innerText = tooltip;
        }else{
            dragIcon.style.backgroundColor = "red";
            dragIcon.innerText = event.dataTransfer.getData("name");
        }
        document.body.appendChild(dragIcon);

        // Set the drag image
        event.dataTransfer.setDragImage(dragIcon, 0, 30);

        // Remove it after a tiny delay so it doesn't stay in the DOM
        setTimeout(() => document.body.removeChild(dragIcon), 0);
    }

    function allowDrop(event) {
        event.preventDefault();
    }

    function insertAtCursor(input, text){
        const start = lastEndSelect;
        const end = lastEndSelect;
        const draggedName = event.dataTransfer.getData("name");
        const type  = event.dataTransfer.getData("type");
        input.focus();
        if(input === currentinput){
            input.value = input.value.substring(0, start) + text + input.value.substring(end);
        }else{
            input.value += text;
        }
        if (type === 'function'){
            if (draggedName.includes(',')){
                input.selectionStart = input.selectionEnd = start + text.length - 3;
            }else{
                input.selectionStart = input.selectionEnd = start + text.length - 2;
            }
        }else{
            input.selectionStart = input.selectionEnd = start + text.length + 1;
        }
        input.focus();
        selectionUpdate(input);
    }

    function dropValue(event) {
        event.preventDefault();
        const draggedName = event.dataTransfer.getData("name");
        const type  = event.dataTransfer.getData("type");
        if (!type) return;
        const input = event.target;
        if(type === 'function'){
            insertAtCursor(input, " " + draggedName + " ");
        }else{
            insertAtCursor(input, " [" + draggedName + "] ");
        }
    }

    function Rename(id) {
        const input = document.getElementById("NameRename"+id);
        input.style.display = (input.style.display === 'none') ? 'block' : 'none';
    }
</script>
