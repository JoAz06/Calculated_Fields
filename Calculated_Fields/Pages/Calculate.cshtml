@page
@model Calculated_Fields.Pages.CalculateModel
@{
    ViewData["Title"] = "Calculate";
}

<form method="post">
    <label for="name">Name :</label>
    <input name="name" type="text"/>
    <label for="value">Value :</label>
    <input name="value" type="text"/>
    <label for="type">Is Calculated :</label>
    <input name="type" type="checkbox"/>

    <button type="submit" asp-page-handler="AddField">Add Field</button>
</form>

<form method="post">
    @for(int i = 0 ; i < Model.AllFields.Count; i++){
        <div class="Field">
            <label for="AllFields[@i].name">@Model.AllFields[i].name :</label>
            <input asp-for="AllFields[@i].Id" type="hidden"/>
            <input asp-for="AllFields[@i].value"/>
            <input asp-for="AllFields[@i].name" id="NameRename@(Model.AllFields[i].Id)" style="display:none"/>
            <button type="button" onclick="Rename(@(Model.AllFields[i].Id))">rename</button>
            <button type="submit" asp-page-handler="RemoveField" asp-route-id=@Model.AllFields[i].Id>remove</button>

                @{
                    if (Model.AllFields[i].type.Equals(Calculated_Fields.Models.Type.CALCULATED)) {
                        if (Model.Results.TryGetValue(Model.AllFields[i].Id, out var result))
                        {
                        if (result.valid){
                            @Html.Raw($"<p style=\"color:green\">{Html.Encode(result)}</p>")
                        }
                        else{
                            @Html.Raw($"<p style=\"color:red\">{Html.Encode(result)}</p>")
                        }
                    }
                    else
                    {
                        @Html.Encode("Unknown error ocurred.");
                    }
            }
            }
        <br/>
        </div>
        }
        <button type="submit" asp-page-handler="Calculate">Calculate</button>

</form>
<script>
    function Rename(id) {
        const input = document.getElementById("NameRename"+id);
        input.style.display = (input.style.display === 'none') ? 'block' : 'none';
    }
</script>
