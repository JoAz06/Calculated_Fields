@page
@model Calculated_Fields.Pages.CalculateModel
@{
    ViewData["Title"] = "Calculate";
}
<form method="post">
    @for(int i = 0 ; i < Model.AllFields.Count; i++){
        <div class="Field">
            <label for="AllFields[@i].name">@Model.AllFields[i].name :</label>
            <input asp-for="AllFields[@i].Id" type="hidden"/>
            <input asp-for="AllFields[@i].value" />
            <input asp-for="AllFields[@i].name" hidden=@(Model.GettingRenamed.Contains(Model.AllFields[@i].Id) ? "" : "hidden") />
            <button type="submit" asp-page-handler="Rename" asp-route-id=@Model.AllFields[i].Id>rename</button>

            @if (Model.AllFields[i].type.Equals(Calculated_Fields.Models.Type.CALCULATED)) {
                <p>
                    Result :
                    <span>
                            @{
                                if (Model.Results.TryGetValue(Model.AllFields[i].Id, out var result))
                                {
                                    @Html.Encode(result);
                                }
                                else
                                {
                                    @Html.Encode("Error in calculation");
                                }
                            }
                    </span>
                </p>
            }
        <br/>
        </div>
        }
        <button type="submit" asp-page-handler="Calculate">Calculate</button>

</form>
