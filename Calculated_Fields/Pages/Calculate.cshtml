@page
@model Calculated_Fields.Pages.CalculateModel
@{
    ViewData["Title"] = "Calculate";
}
<div class="container">
    <main>
        <form method="post">
            <label for="name">Name :</label>
            <input name="name" type="text"/>
            <label for="value">Value :</label>
            <input name="value" type="text" ondragover="allowDrop(event)" ondrop="dropValue(event)" class="completable" id="testerid"/>
            <label for="type">Is Calculated :</label>
            <input name="type" type="checkbox"/>
            <button type="submit" asp-page-handler="AddField">Add Field</button>

        </form>
        <form form method="post">
            <div id="fields" class="list-group">
            @for(int i = 0 ; i < Model.AllFields.Count; i++){
                    <div class="Field list-group-item">
                    <span draggable="true" data-name="@Model.AllFields[i].name" ondragstart="dragStart(event,'data')">⩨</span>
                    <button onclick="pickValue('@Model.AllFields[i].name','data',event)">▨</button>
                    <label for="AllFields[@i].name">@Model.AllFields[i].name :</label>
                    <input asp-for="AllFields[@i].Id" type="hidden"/>
                    <input asp-for="AllFields[@i].value" ondragover="allowDrop(event)" ondrop="dropValue(event)" class="completable"/>
                    <input asp-for="AllFields[@i].name" id="NameRename@(Model.AllFields[i].Id)" style="display:none"/>
                    <button type="button" onclick="Rename(@(Model.AllFields[i].Id))">rename</button>
                    <button type="submit" asp-page-handler="RemoveField" asp-route-id=@Model.AllFields[i].Id>remove</button>

                        @{
                            if (Model.AllFields[i].type.Equals(Calculated_Fields.Models.Type.CALCULATED)) {
                                if (Model.Results.TryGetValue(Model.AllFields[i].Id, out var result))
                                {
                                if (result.valid){
                                    @Html.Raw($"<p style=\"color:green\">{Html.Encode(result)}</p>")
                                }
                                else{
                                    @Html.Raw($"<p style=\"color:red\">{Html.Encode(result)}</p>")
                                }
                            }
                            else
                            {
                                @Html.Encode("Unknown error ocurred.");
                            }
                    }
                    }
                <br/>
                </div>
        
            }
            </div>
             <button type="submit" asp-page-handler="Calculate">Calculate</button>

        </form>
    </main>
    <aside>
        <h3>Cheat Sheet</h3>
        @foreach(var function in Model.Functions) {
            <div class="function" title="@function.tooltip">
                <span draggable="true" data-name="@function.equation" ondragstart="dragStart(event,'function',' @function.tooltip')">≡</span>
                @function.name
                <button onclick="pickValue('@function.equation','function',event)">⩨</button>
            </div>
        }
    </aside>
</div>

<script>//All of this javascript can be replaced by the more modern AJAX Framework
    let lastFocusedInput = null;

    document.querySelectorAll('input[class="completable"]').forEach(input => {
        input.addEventListener('focus', (e) => {
            lastFocusedInput = e.target;
        });
    });

    function pickValue(text,type,event) {
        event.preventDefault();
        const input = lastFocusedInput;
        const start = input.selectionStart;
        const end = input.selectionEnd;
        if(type === 'function'){
            input.value = input.value.substring(0, start) + " " + text + " " + input.value.substring(end);
        }else{
            input.value = input.value.substring(0, start) + " [" + text + "] " + input.value.substring(end);
        }
        if (type === 'function'){
            if (text.includes(',')){
                input.selectionStart = input.selectionEnd = start + text.length - 1;
            }else{
                input.selectionStart = input.selectionEnd = start + text.length;
            }
        }else{
            input.selectionStart = input.selectionEnd = start + text.length + 4;
        }
        input.focus();
    }

    function dragStart(event,type,tooltip) {
        event.dataTransfer.setData("name", event.currentTarget.dataset.name);
        event.dataTransfer.setData("type", type);
        event.dataTransfer.setData("tooltip", tooltip);

        const dragIcon = document.createElement("div");
        dragIcon.style.width = "fit-content";
        dragIcon.style.height = "30px";
        
        dragIcon.style.color = "white";
        dragIcon.style.borderRadius = "5px";
        dragIcon.style.fontWeight = "bold";
        
        
        if(type == 'function'){
            dragIcon.style.backgroundColor = "blue";
            dragIcon.innerText = tooltip;
        }else{
            dragIcon.style.backgroundColor = "red";
            dragIcon.innerText = event.dataTransfer.getData("name");
        }
        document.body.appendChild(dragIcon);

        // Set the drag image
        event.dataTransfer.setDragImage(dragIcon, 0, 30);

        // Remove it after a tiny delay so it doesn't stay in the DOM
        setTimeout(() => document.body.removeChild(dragIcon), 0);
    }

    function allowDrop(event) {
        event.preventDefault();
    }

    function insertAtCursor(input, text){
        const start = input.selectionStart;
        const end = input.selectionEnd;
        const draggedName = event.dataTransfer.getData("name");
        const type  = event.dataTransfer.getData("type");
        if(input === lastFocusedInput){
            input.value = input.value.substring(0, start) + text + input.value.substring(end);
        }else{
            input.value += text;
        }
        if (type === 'function'){
            if (draggedName.includes(',')){
                input.selectionStart = input.selectionEnd = start + text.length - 3;
            }else{
                input.selectionStart = input.selectionEnd = start + text.length - 2;
            }
        }else{
            input.selectionStart = input.selectionEnd = start + text.length;
        }
        input.focus();
    }

    function dropValue(event) {
        event.preventDefault();
        const draggedName = event.dataTransfer.getData("name");
        const type  = event.dataTransfer.getData("type");
        const input = event.target;
        if(type === 'function'){
            insertAtCursor(input, " " + draggedName + " ");
        }else{
            insertAtCursor(input, " [" + draggedName + "] ");
        }
    }

    function Rename(id) {
        const input = document.getElementById("NameRename"+id);
        input.style.display = (input.style.display === 'none') ? 'block' : 'none';
    }
</script>
